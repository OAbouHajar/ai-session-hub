{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook-client.mjs\" copilot sessionStart",
        "powershell": "node \"${PLUGIN_ROOT}\\scripts\\hook-client.mjs\" copilot sessionStart",
        "timeoutSec": 8
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook-client.mjs\" copilot agentStop",
        "powershell": "node \"${PLUGIN_ROOT}\\scripts\\hook-client.mjs\" copilot agentStop",
        "timeoutSec": 8
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook-client.mjs\" copilot sessionEnd",
        "powershell": "node \"${PLUGIN_ROOT}\\scripts\\hook-client.mjs\" copilot sessionEnd",
        "timeoutSec": 8
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/scripts/hook-client.mjs\" copilot preCompact",
        "powershell": "node \"${PLUGIN_ROOT}\\scripts\\hook-client.mjs\" copilot preCompact",
        "timeoutSec": 8
      }
    ]
  }
}
